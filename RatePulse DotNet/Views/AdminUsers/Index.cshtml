@model RatePulse.Models.ViewModels.UsersViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Kullanıcılar";
}

<div class="bg-white rounded-xl shadow-sm p-5 mb-6">
    <form method="get" class="flex flex-wrap gap-3 items-end">
        <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">Ara</label>
            <input type="text" name="search" value="@Model.SearchQuery"
                   placeholder="E-posta veya isim..."
                   class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 w-56" />
        </div>
        <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">Rol</label>
            @{
                var roleOptions = new[] { ("", "Tümü"), ("user", "Kullanıcı"), ("moderator", "Moderatör"), ("admin", "Admin"), ("superadmin", "Süper Admin") };
            }
            <select name="role" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                @foreach (var (val, label) in roleOptions)
                {
                    if (Model.RoleFilter == val || (val == "" && Model.RoleFilter == null))
                    {
                        <option value="@val" selected>@label</option>
                    }
                    else
                    {
                        <option value="@val">@label</option>
                    }
                }
            </select>
        </div>
        <button type="submit" class="bg-indigo-600 text-white text-sm px-4 py-2 rounded-lg hover:bg-indigo-700 transition-colors">
            Filtrele
        </button>
    </form>
</div>

<div class="bg-white rounded-xl shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b flex items-center justify-between">
        <h2 class="font-semibold text-gray-700">Kullanıcı Listesi</h2>
        <span class="text-sm text-gray-500">@Model.TotalCount kullanıcı</span>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 text-gray-500 uppercase text-xs">
                <tr>
                    <th class="px-6 py-3 text-left">Kullanıcı</th>
                    <th class="px-6 py-3 text-left">Rol</th>
                    <th class="px-6 py-3 text-left">Durum</th>
                    <th class="px-6 py-3 text-left">Kayıt Tarihi</th>
                    <th class="px-6 py-3 text-left">Son Giriş</th>
                    <th class="px-6 py-3 text-left">İşlem</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var user in Model.Users)
                {
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4">
                            <div>
                                <p class="font-medium text-gray-800">@user.DisplayName</p>
                                <p class="text-gray-400 text-xs">@user.Email</p>
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            @{
                                var roleColors = new Dictionary<string, string>
                                {
                                    ["user"] = "bg-gray-100 text-gray-600",
                                    ["moderator"] = "bg-blue-100 text-blue-700",
                                    ["admin"] = "bg-indigo-100 text-indigo-700",
                                    ["superadmin"] = "bg-purple-100 text-purple-700"
                                };
                                var color = roleColors.TryGetValue(user.Role, out var c) ? c : "bg-gray-100 text-gray-600";
                            }
                            <span class="@color text-xs font-medium px-2.5 py-1 rounded-full">@user.Role</span>
                        </td>
                        <td class="px-6 py-4">
                            @if (user.IsBanned)
                            {
                                <span class="bg-red-100 text-red-700 text-xs font-medium px-2.5 py-1 rounded-full">Askıya Alındı</span>
                            }
                            else
                            {
                                <span class="bg-green-100 text-green-700 text-xs font-medium px-2.5 py-1 rounded-full">Aktif</span>
                            }
                        </td>
                        <td class="px-6 py-4 text-gray-500">@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="px-6 py-4 text-gray-500">@user.LastLogin.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="px-6 py-4">
                            <a href="/admin/users/@user.Uid"
                               class="text-indigo-600 hover:text-indigo-800 font-medium text-xs">Detay →</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Users.Any())
        {
            <div class="text-center py-12 text-gray-400">
                <p class="text-4xl mb-2">👤</p>
                <p class="text-sm">Kullanıcı bulunamadı.</p>
            </div>
        }
    </div>
</div>
