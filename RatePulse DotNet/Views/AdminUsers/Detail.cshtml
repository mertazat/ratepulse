@model RatePulse.Models.ViewModels.UserDetailViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Kullanıcı Detay";
}

<div class="mb-4">
    <a href="/admin/users" class="text-sm text-indigo-600 hover:underline">← Kullanıcılar</a>
</div>

<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
    <div class="xl:col-span-1 space-y-5">
        <div class="bg-white rounded-xl shadow-sm p-6">
            <div class="flex items-center gap-4 mb-5">
                <div class="bg-indigo-100 text-indigo-600 rounded-full w-14 h-14 flex items-center justify-center text-2xl font-bold">
                    @(string.IsNullOrEmpty(Model.User.DisplayName) ? "?" : Model.User.DisplayName[0].ToString().ToUpper())
                </div>
                <div>
                    <h2 class="text-lg font-bold text-gray-800">@Model.User.DisplayName</h2>
                    <p class="text-sm text-gray-500">@Model.User.Email</p>
                </div>
            </div>

            <div class="space-y-3 text-sm">
                <div class="flex justify-between">
                    <span class="text-gray-500">Rol</span>
                    <span class="font-medium">@Model.User.Role</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Durum</span>
                    @if (Model.User.IsBanned)
                    {
                        <span class="text-red-600 font-medium">Askıya Alındı</span>
                    }
                    else
                    {
                        <span class="text-green-600 font-medium">Aktif</span>
                    }
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Kayıt</span>
                    <span>@Model.User.CreatedAt.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Son Giriş</span>
                    <span>@Model.User.LastLogin.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Aktif Alarm</span>
                    <span>@Model.Alerts.Count(a => a.IsActive)</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Tetiklenen</span>
                    <span>@Model.TriggeredAlertsCount</span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm p-6">
            <h3 class="font-semibold text-gray-700 mb-4">Rol Değiştir</h3>
            <form method="post" action="/admin/users/@Model.User.Uid/role">
                <select name="role" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm mb-3 focus:ring-2 focus:ring-indigo-500">
                    @foreach (var (val, label) in new[] { ("user", "Kullanıcı"), ("moderator", "Moderatör"), ("admin", "Admin"), ("superadmin", "Süper Admin") })
                    {
                        if (Model.User.Role == val)
                        {
                            <option value="@val" selected>@label</option>
                        }
                        else
                        {
                            <option value="@val">@label</option>
                        }
                    }
                </select>
                <button type="submit" class="w-full bg-indigo-600 text-white text-sm py-2 rounded-lg hover:bg-indigo-700">
                    Güncelle
                </button>
            </form>
        </div>

        <div class="bg-white rounded-xl shadow-sm p-6 space-y-3">
            <form method="post" action="/admin/users/@Model.User.Uid/ban">
                <button type="submit"
                        class="w-full @(Model.User.IsBanned ? "bg-green-50 text-green-700 border border-green-200 hover:bg-green-100" : "bg-red-50 text-red-700 border border-red-200 hover:bg-red-100") text-sm py-2 rounded-lg transition-colors">
                    @(Model.User.IsBanned ? "Askıyı Kaldır" : "Askıya Al")
                </button>
            </form>
            <form method="post" action="/admin/users/@Model.User.Uid/delete"
                  onsubmit="return confirm('Kullanıcıyı silmek istediğinizden emin misiniz?')">
                <button type="submit" class="w-full bg-gray-100 text-gray-600 text-sm py-2 rounded-lg hover:bg-gray-200">
                    Kullanıcıyı Sil
                </button>
            </form>
        </div>
    </div>

    <div class="xl:col-span-2">
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b">
                <h3 class="font-semibold text-gray-700">Kullanıcı Alarmları (@Model.Alerts.Count)</h3>
            </div>
            @if (Model.Alerts.Any())
            {
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 text-gray-500 uppercase text-xs">
                        <tr>
                            <th class="px-6 py-3 text-left">Çift</th>
                            <th class="px-6 py-3 text-left">Hedef</th>
                            <th class="px-6 py-3 text-left">Yön</th>
                            <th class="px-6 py-3 text-left">Durum</th>
                            <th class="px-6 py-3 text-left">Tarih</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var alert in Model.Alerts)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-3 font-medium">@alert.FromCurrency / @alert.ToCurrency</td>
                                <td class="px-6 py-3">@alert.TargetRate.ToString("F4")</td>
                                <td class="px-6 py-3">
                                    <span class="@(alert.Direction == "above" ? "text-green-600" : "text-red-600") font-medium">
                                        @(alert.Direction == "above" ? "↑ Üstünde" : "↓ Altında")
                                    </span>
                                </td>
                                <td class="px-6 py-3">
                                    @if (alert.IsActive)
                                    {
                                        <span class="bg-green-100 text-green-700 text-xs px-2 py-0.5 rounded-full">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="bg-gray-100 text-gray-500 text-xs px-2 py-0.5 rounded-full">Tetiklendi</span>
                                    }
                                </td>
                                <td class="px-6 py-3 text-gray-500">@alert.CreatedAt.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center py-12 text-gray-400">
                    <p class="text-4xl mb-2">🔔</p>
                    <p class="text-sm">Bu kullanıcının alarmı yok.</p>
                </div>
            }
        </div>
    </div>
</div>
