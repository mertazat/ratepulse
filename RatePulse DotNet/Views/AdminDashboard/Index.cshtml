@model RatePulse.Models.ViewModels.DashboardViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 mb-8">
    <div class="bg-white rounded-xl shadow-sm p-5 flex items-center gap-4">
        <div class="bg-indigo-100 text-indigo-600 rounded-lg p-3 text-2xl">👥</div>
        <div>
            <p class="text-sm text-gray-500">Toplam Kullanıcı</p>
            <p class="text-2xl font-bold text-gray-800">@Model.TotalUsers</p>
        </div>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-5 flex items-center gap-4">
        <div class="bg-green-100 text-green-600 rounded-lg p-3 text-2xl">🔔</div>
        <div>
            <p class="text-sm text-gray-500">Aktif Alarm</p>
            <p class="text-2xl font-bold text-gray-800">@Model.ActiveAlerts</p>
        </div>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-5 flex items-center gap-4">
        <div class="bg-yellow-100 text-yellow-600 rounded-lg p-3 text-2xl">🆕</div>
        <div>
            <p class="text-sm text-gray-500">Bu Hafta Kayıt</p>
            <p class="text-2xl font-bold text-gray-800">@Model.NewUsersThisWeek</p>
        </div>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-5 flex items-center gap-4">
        <div class="bg-blue-100 text-blue-600 rounded-lg p-3 text-2xl">💱</div>
        <div>
            <p class="text-sm text-gray-500">Son Kur Güncelleme</p>
            <p class="text-sm font-semibold text-gray-800">
                @(Model.LastRateFetch == DateTime.MinValue ? "—" : Model.LastRateFetch.ToString("HH:mm dd/MM"))
            </p>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 xl:grid-cols-3 gap-6 mb-8">
    <div class="xl:col-span-2 bg-white rounded-xl shadow-sm p-6">
        <h2 class="text-base font-semibold text-gray-700 mb-4">Son 7 Gün — Yeni Kayıtlar</h2>
        <canvas id="registrationChart" height="100"></canvas>
    </div>

    <div class="bg-white rounded-xl shadow-sm p-6">
        <h2 class="text-base font-semibold text-gray-700 mb-4">Top Döviz Çiftleri</h2>
        @if (Model.TopCurrencyPairs.Any())
        {
            <ul class="space-y-3">
                @foreach (var pair in Model.TopCurrencyPairs)
                {
                    <li class="flex items-center justify-between">
                        <span class="text-sm font-medium text-gray-700">@pair.Pair</span>
                        <span class="bg-indigo-100 text-indigo-700 text-xs font-semibold px-2.5 py-1 rounded-full">
                            @pair.AlertCount alarm
                        </span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-sm text-gray-400">Henüz alarm yok.</p>
        }
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm p-6">
    <div class="flex items-center justify-between mb-4">
        <h2 class="text-base font-semibold text-gray-700">Anlık Kurlar (USD bazlı)</h2>
        <a href="/admin/rates/refresh" class="text-xs text-indigo-600 hover:underline">Yenile →</a>
    </div>
    @if (Model.LatestRates.Any())
    {
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
            @foreach (var rate in Model.LatestRates)
            {
                <div class="bg-gray-50 rounded-lg p-3 text-center">
                    <p class="text-xs font-semibold text-gray-500">@rate.Key</p>
                    <p class="text-lg font-bold text-indigo-700">@rate.Value.ToString("F4")</p>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-sm text-gray-400">Kur verisi bulunamadı.</p>
    }
</div>

@section Scripts {
<script>
    const labels = [@Html.Raw(string.Join(",", Model.DailyUserStats.Select(d => $"'{d.Date}'")))];
    const data = [@Html.Raw(string.Join(",", Model.DailyUserStats.Select(d => d.Count)))];

    new Chart(document.getElementById('registrationChart'), {
        type: 'bar',
        data: {
            labels,
            datasets: [{
                label: 'Yeni Kullanıcı',
                data,
                backgroundColor: 'rgba(99, 102, 241, 0.7)',
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
    });
</script>
}
