@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Döviz Kurları";
    var latest = ViewBag.Latest as RatePulse.Models.Firestore.RateModel;
    var history = ViewBag.History as List<RatePulse.Models.Firestore.RateModel> ?? new();
    var historyChronological = ViewBag.HistoryChronological as List<RatePulse.Models.Firestore.RateModel> ?? new();
}

<div class="flex items-center justify-between mb-6">
    <div>
        @if (latest != null)
        {
            <p class="text-sm text-gray-500">Son güncelleme: <span class="font-medium">@latest.FetchedAt.ToString("HH:mm — dd/MM/yyyy")</span></p>
        }
    </div>
    <form method="post" action="/admin/rates/refresh">
        <button type="submit" class="bg-indigo-600 text-white text-sm px-4 py-2 rounded-lg hover:bg-indigo-700 transition-colors">
            🔄 Manuel Güncelle
        </button>
    </form>
</div>

@if (latest != null)
{
    <div class="bg-white rounded-xl shadow-sm p-6 mb-6">
        <h2 class="font-semibold text-gray-700 mb-4">Anlık Kurlar (USD = 1)</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
            @foreach (var rate in latest.Values.OrderBy(r => r.Key))
            {
                <div class="bg-gradient-to-br from-indigo-50 to-white border border-indigo-100 rounded-xl p-4 text-center">
                    <p class="text-xs font-bold text-indigo-400 mb-1">@rate.Key</p>
                    <p class="text-xl font-bold text-indigo-700">@rate.Value.ToString("F4")</p>
                </div>
            }
        </div>
    </div>
}

<div class="bg-white rounded-xl shadow-sm p-6 mb-6">
    <div class="flex items-center gap-4 mb-4">
        <h2 class="font-semibold text-gray-700">USD/TRY Geçmiş Grafik</h2>
    </div>
    <canvas id="historyChart" height="80"></canvas>
</div>

<div class="bg-white rounded-xl shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b">
        <h2 class="font-semibold text-gray-700">Kur Geçmişi (Son 48 kayıt)</h2>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 text-gray-500 uppercase text-xs">
                <tr>
                    <th class="px-6 py-3 text-left">Tarih/Saat</th>
                    <th class="px-6 py-3 text-left">TRY</th>
                    <th class="px-6 py-3 text-left">EUR</th>
                    <th class="px-6 py-3 text-left">GBP</th>
                    <th class="px-6 py-3 text-left">JPY</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var r in history)
                {
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-3 text-gray-500">@r.FetchedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="px-6 py-3 font-medium">@(r.Values.TryGetValue("TRY", out var t) ? t.ToString("F4") : "—")</td>
                        <td class="px-6 py-3">@(r.Values.TryGetValue("EUR", out var e) ? e.ToString("F4") : "—")</td>
                        <td class="px-6 py-3">@(r.Values.TryGetValue("GBP", out var g) ? g.ToString("F4") : "—")</td>
                        <td class="px-6 py-3">@(r.Values.TryGetValue("JPY", out var j) ? j.ToString("F4") : "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    const labels = [@Html.Raw(string.Join(",", historyChronological.Select(r => $"'{r.FetchedAt:dd/MM HH:mm}'")))];
    const tryData = [@Html.Raw(string.Join(",", historyChronological.Select(r => r.Values.TryGetValue("TRY", out var v) ? v.ToString("F4", System.Globalization.CultureInfo.InvariantCulture) : "null")))];

    new Chart(document.getElementById('historyChart'), {
        type: 'line',
        data: {
            labels,
            datasets: [{
                label: 'USD/TRY',
                data: tryData,
                borderColor: 'rgb(99, 102, 241)',
                backgroundColor: 'rgba(99, 102, 241, 0.1)',
                fill: true,
                tension: 0.3,
                pointRadius: 2
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: false } }
        }
    });
</script>
}
