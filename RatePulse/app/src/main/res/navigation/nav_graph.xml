<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.mertazat.ratepulse.ui.auth.LoginFragment"
        android:label="Giriş">
        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.mertazat.ratepulse.ui.auth.RegisterFragment"
        android:label="Kayıt">
        <action
            android:id="@+id/action_registerFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.mertazat.ratepulse.ui.dashboard.DashboardFragment"
        android:label="Dashboard" />

    <fragment
        android:id="@+id/alertsFragment"
        android:name="com.mertazat.ratepulse.ui.alerts.AlertsFragment"
        android:label="Alarmlar">
        <action
            android:id="@+id/action_alertsFragment_to_createAlertFragment"
            app:destination="@id/createAlertFragment" />
    </fragment>

    <fragment
        android:id="@+id/createAlertFragment"
        android:name="com.mertazat.ratepulse.ui.alerts.CreateAlertFragment"
        android:label="Yeni Alarm" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.mertazat.ratepulse.ui.profile.ProfileFragment"
        android:label="Profil">
        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
